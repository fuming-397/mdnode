# 子目录部署（例如 /blog）时，请给每行路径加上该前缀，例如：
#   /blog/posts   /blog/posts.html   200

# 旧的无后缀链接（含结尾斜杠写法）
/posts            /posts.html    200
/posts/           /posts.html    200
/post             /post.html     200
/post/            /post.html     200
/search           /search.html   200
/search/          /search.html   200

